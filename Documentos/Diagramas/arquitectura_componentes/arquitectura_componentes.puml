@startuml
skinparam componentStyle uml2
skinparam shadowing false

package "Clientes (Agnostico)" {
  [Interfaz Web (Angular)] as Web
  [Extension IDE / CLI] as CLI
  [Pipeline CI/CD] as CICD
}

package "Backend FastAPI (Monolito Modular)" {
  
  package "Capa HTTP (API REST)" {
    [Analyzer Router\n(/api/v1/analyze)] as Router
    [Pydantic Schemas\n(Validacion + OWASP/CWE)] as Schemas
  }

  package "Capa de Negocio (Service)" {
    [Analyzer Service\n(Orquestador Hibrido)] as Service
    [Cache Manager\n(Hash SHA-256 + Rules Version)] as Cache
  }

  package "Motores de Analisis (Patron Strategy)" {
    [EngineRegistry] as Registry
    interface "BaseEngine" as IEngine
    [Python AST Engine] as PyEngine
    [C Static Engine] as CEngine
    [AI Context Engine] as AIEngine
  }

  folder "Base de Conocimiento (Rules JSON)" {
    [metadata.json\n(Version OWASP/CWE)] as MetaRules
    [python_rules.json] as PyRules
    [c_rules.json] as CRules
  }

  package "Infraestructura y Transversal (Core & Common)" {
    [Config Manager (.env)] as Config
    [Central Logger] as Logger
    [Exception Handler] as Exc
    [Repository Pattern] as Repo
  }
}

database "Base de Datos\n(SQLite / PostgreSQL)" as DB
cloud "LLM Externo / Local\n(Ollama / API)" as LLM

Web --> Router : HTTPS / JSON
CLI --> Router : HTTPS / JSON
CICD --> Router : HTTPS / JSON

Router --> Schemas : Valida entrada/salida
Router --> Service : Inyeccion de Dependencias

Service --> Cache : Verifica Hash + Version
Service --> Registry : Consulta motores por lenguaje
Service --> Repo : Persiste resultados

Registry o-- IEngine : gestiona
IEngine <|.. PyEngine
IEngine <|.. CEngine
IEngine <|.. AIEngine

PyEngine --> PyRules : Carga dinamica
CEngine --> CRules : Carga dinamica
Service --> MetaRules : Consulta version vigente

AIEngine --> LLM : Consulta contextual
Repo --> DB : SQLAlchemy / SQLModel

Service ..> Logger : Registra trazas
Service ..> Exc : Aisla fallos
Config ..> Service : Parametros
@enduml
