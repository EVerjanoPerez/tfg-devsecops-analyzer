APP_NAME="Analizador SAST Ciberseguridad TFG"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Seguridad y limites (Proteccion DoS - RNF-06)
MAX_CODE_SIZE_KB=256
ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:8000"]

# Base de datos (SQLite en desarrollo)
DATABASE_URL="sqlite:///./sast_tfg.db"

# Configuracion Motor IA (mock | gemini | ollama)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=15